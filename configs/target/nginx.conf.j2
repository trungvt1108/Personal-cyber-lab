limit_req_zone $binary_remote_addr zone=cyberlab_demo:1m rate=4r/s;
log_format cyberlab escape=json '{"timestamp":"$time_iso8601","src_ip":"$remote_addr",'
  '"dest_ip":"$server_addr","method":"$request_method","path":"$uri",'
  '"status":$status,"protocol":"$server_protocol","bytes":$body_bytes_sent}';

server {
  listen {{ lab_config.hosts.target.ip }}:{{ lab_config.services.http }};
  server_name _;
  server_tokens off;
  allow {{ lab_config.hosts.kali.ip }};
  deny all;
  access_log /var/log/nginx/cyberlab-access.jsonl cyberlab;
  error_log /var/log/nginx/cyberlab-error.log warn;
  client_max_body_size 1k;
  client_body_timeout 5s;
  client_header_timeout 5s;
  keepalive_timeout 5s;
  add_header X-Content-Type-Options nosniff always;

  location / {
    limit_req zone=cyberlab_demo burst=8 nodelay;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host lab-target;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_connect_timeout 2s;
    proxy_read_timeout 5s;
  }
}
