alert icmp $HOME_NET any -> $LAB_TARGET any (msg:"CYBERLAB educational ICMP echo"; itype:8; classtype:misc-activity; sid:1000001; rev:1;)
alert tcp $HOME_NET any -> $LAB_TARGET any (msg:"CYBERLAB possible small discovery SYN pattern"; flags:S; flow:stateless; threshold:type threshold, track by_src, count 4, seconds 20; classtype:attempted-recon; sid:1000002; rev:1;)
alert tcp $HOME_NET any -> $LAB_TARGET {{ lab_config.services.ssh }} (msg:"CYBERLAB repeated SSH connections (not authentication verdict)"; flags:S; flow:stateless; threshold:type threshold, track by_src, count 3, seconds 20; classtype:misc-activity; sid:1000003; rev:1;)
alert http $HOME_NET any -> $LAB_TARGET {{ lab_config.services.http }} (msg:"CYBERLAB harmless admin-test marker"; flow:established,to_server; http.uri; content:"/admin-test"; startswith; classtype:misc-activity; sid:1000004; rev:1;)
alert http $HOME_NET any -> $LAB_TARGET {{ lab_config.services.http }} (msg:"CYBERLAB harmless security-test marker"; flow:established,to_server; http.uri; content:"/security-test"; startswith; classtype:misc-activity; sid:1000005; rev:1;)
alert http $HOME_NET any -> $LAB_TARGET {{ lab_config.services.http }} (msg:"CYBERLAB harmless scanner-test marker"; flow:established,to_server; http.uri; content:"/scanner-test"; startswith; classtype:misc-activity; sid:1000006; rev:1;)
alert http $HOME_NET any -> $LAB_TARGET {{ lab_config.services.http }} (msg:"CYBERLAB elevated educational HTTP frequency"; flow:established,to_server; http.method; content:"GET"; detection_filter:track by_src, count 5, seconds 10; classtype:misc-activity; sid:1000007; rev:1;)
alert tcp $HOME_NET any -> $LAB_TARGET any (msg:"CYBERLAB unexpected SYN FIN combination"; flags:SF; flow:stateless; classtype:bad-unknown; sid:1000008; rev:1;)
